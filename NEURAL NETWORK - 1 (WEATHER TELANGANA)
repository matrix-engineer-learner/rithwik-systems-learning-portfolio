        "# @title 🧠 Universal Neural Network Core Engine & Animated Live Graph\n",
        "# @markdown Select your network dimensions, tune your learning rate, and watch the data pulse live!\n",
        "\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Dense, Input\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display, HTML, clear_output\n",
        "import time\n",
        "\n",
        "# 1. GENERATE ALL-PURPOSE DATASETS\n",
        "def generate_matrix_data(data_type=\"Linear Numeric Patterns\"):\n",
        "    np.random.seed(42)\n",
        "    X = np.random.uniform(-10, 10, (500, 4))\n",
        "    if data_type == \"Linear Numeric Patterns\":\n",
        "        y = X[:, 0] * 2.5 - X[:, 1] * 1.2 + X[:, 2] * 0.7 + np.random.normal(0, 0.1, 500)\n",
        "    else:\n",
        "        y = np.where(np.sin(X[:, 0]) + np.cos(X[:, 1]) > 0.5, 1, 0)\n",
        "    return X, y\n",
        "\n",
        "# 2. DYNAMIC PROCESSING ENGINE\n",
        "output_area = widgets.Output()\n",
        "\n",
        "Data_Mode = widgets.Dropdown(options=['Linear Numeric Patterns', 'Non-Linear Classifications'], value='Linear Numeric Patterns', description='📊 Data Mode:')\n",
        "Hidden_Neurons = widgets.IntSlider(value=8, min=4, max=16, step=4, description='🎛️ Nodes:')\n",
        "Learning_Rate = widgets.Dropdown(options=[0.1, 0.01, 0.001], value=0.01, description='⚡ Learn Rate:')\n",
        "Epoch_Runs = widgets.IntSlider(value=20, min=5, max=50, step=5, description='🔄 Loops:')\n",
        "\n",
        "def execute_core_network(b):\n",
        "    with output_area:\n",
        "        clear_output(wait=True)\n",
        "\n",
        "        mode = Data_Mode.value\n",
        "        neurons = Hidden_Neurons.value\n",
        "        lr = Learning_Rate.value\n",
        "        epochs = Epoch_Runs.value\n",
        "\n",
        "        X, y = generate_matrix_data(mode)\n",
        "        loss_func = 'mse' if mode == 'Linear Numeric Patterns' else 'binary_crossentropy'\n",
        "        final_activation = 'linear' if mode == 'Linear Numeric Patterns' else 'sigmoid'\n",
        "\n",
        "        # Build network model\n",
        "        core_brain = Sequential([\n",
        "            Input(shape=(4,)),\n",
        "            Dense(neurons, activation='relu'),\n",
        "            Dense(max(2, int(neurons/2)), activation='relu'),\n",
        "            Dense(1, activation=final_activation)\n",
        "        ])\n",
        "        core_brain.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=lr), loss=loss_func)\n",
        "\n",
        "        # Train model live\n",
        "        history = core_brain.fit(X, y, epochs=epochs, verbose=0)\n",
        "        final_loss = history.history['loss'][-1]\n",
        "\n",
        "        test_vector = np.array([[2.5, -1.2, 5.0, 0.5]])\n",
        "        raw_prediction = core_brain.predict(test_vector, verbose=0)\n",
        "        prediction_value = float(raw_prediction)\n",
        "\n",
        "        # Determine node placement metrics for animation engine\n",
        "        layer_counts = [4, neurons, max(2, int(neurons/2)), 1]\n",
        "        x_positions = [60, 190, 320, 450]\n",
        "\n",
        "        # GENERATE SECURE EMBEDDED ANIMATED SVG GRAPH (100% RELIABLE)\n",
        "        svg_lines = \"\"\n",
        "        svg_dots = \"\"\n",
        "\n",
        "        # Step 1: Pre-calculate coordinates grids\n",
        "        all_coords = []\n",
        "        for l_idx, count in enumerate(layer_counts):\n",
        "            y_coords = np.linspace(25, 205, count)\n",
        "            layer_pts = [(x_positions[l_idx], y) for y in y_coords]\n",
        "            all_coords.append(layer_pts)\n",
        "\n",
        "        # Step 2: Draw data tracks and animated pulsing signals\n",
        "        packet_id = 0\n",
        "        for l in range(len(all_coords) - 1):\n",
        "            curr_layer = all_coords[l]\n",
        "            next_layer = all_coords[l+1]\n",
        "            for p1 in curr_layer:\n",
        "                for p2 in next_layer:\n",
        "                    # Draw static link lines\n",
        "                    svg_lines += f'<line x1=\"{p1[0]}\" y1=\"{p1[1]}\" x2=\"{p2[0]}\" y2=\"{p2[1]}\" stroke=\"#38bdf8\" stroke-width=\"1\" opacity=\"0.18\" />'\n",
        "                    # Add animated pulsing data packets traveling down the lines\n",
        "                    anim_dur = np.random.uniform(1.2, 2.5)\n",
        "                    svg_lines += f\"\"\"\n",
        "                    <circle r=\"2\" fill=\"#38bdf8\">\n",
        "                        <animateMotion path=\"M {p1[0]} {p1[1]} L {p2[0]} {p2[1]}\" dur=\"{anim_dur}s\" repeatCount=\"indefinite\" begin=\"{np.random.uniform(0, 1)}s\" />\n",
        "                    </circle>\n",
        "                    \"\"\"\n",
        "                    packet_id += 1\n",
        "\n",
        "        # Step 3: Draw glowing pulsing neuron dots\n",
        "        for l_idx, layer_nodes in enumerate(all_coords):\n",
        "            for p in layer_nodes:\n",
        "                if l_idx == 0:\n",
        "                    base_color, glow_color = \"#c084fc\", \"#e9d5ff\" # Purple inputs\n",
        "                elif l_idx == len(all_coords) - 1:\n",
        "                    base_color, glow_color = \"#fbbf24\", \"#fde68a\" # Yellow output\n",
        "                else:\n",
        "                    base_color, glow_color = \"#38bdf8\", \"#bae6fd\" # Cyan processing nodes\n",
        "\n",
        "                anim_delay = np.random.uniform(0, 0.8)\n",
        "                svg_dots += f\"\"\"\n",
        "                <g>\n",
        "                    <!-- Glowing aura ring behind the node -->\n",
        "                    <circle cx=\"{p[0]}\" cy=\"{p[1]}\" r=\"6\" fill=\"{base_color}\" opacity=\"0.4\">\n",
        "                        <animate attributeName=\"r\" values=\"6;11;6\" dur=\"2s\" begin=\"{anim_delay}s\" repeatCount=\"indefinite\" />\n",
        "                        <animate attributeName=\"opacity\" values=\"0.4;0.0;0.4\" dur=\"2s\" begin=\"{anim_delay}s\" repeatCount=\"indefinite\" />\n",
        "                    </circle>\n",
        "                    <!-- Solid target node core -->\n",
        "                    <circle cx=\"{p[0]}\" cy=\"{p[1]}\" r=\"5.5\" fill=\"{base_color}\" stroke=\"#ffffff\" stroke-width=\"0.8\" />\n",
        "                </g>\n",
        "                \"\"\"\n",
        "\n",
        "        # Step 4: Render complete dark cyberpunk container panel\n",
        "        display(HTML(f'''\n",
        "            <div style=\"font-family: 'Segoe UI', sans-serif; background-color: #0f172a; padding: 25px; border-radius: 8px; border: 1px solid #1e293b; box-shadow: 0 10px 30px rgba(0,0,0,0.35); max-width: 560px; margin: auto;\">\n",
        "                <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; padding-bottom: 12px; margin-bottom: 15px;\">\n",
        "                    <span style=\"font-size: 11px; font-family: monospace; tracking: 1px; color: #64748b;\">ACTIVE PROCESSING MATRIX DATA FORWARD ROUTING</span>\n",
        "                    <span style=\"padding: 4px 10px; border-radius: 4px; background-color: #38bdf815; color: #38bdf8; font-size: 10px; font-weight: bold; border: 1px solid #38bdf844; font-family: monospace; animation: terminal_pulse 1.5s infinite alternate;\">COMPUTING::LIVE</span>\n",
        "                </div>\n",
        "\n",
        "                <!-- LIVE ANIMATED INTERCONNECTED GRIDS WINDOW -->\n",
        "                <div style=\"background: #070b14; border: 1px solid #1e293b; border-radius: 6px; padding: 10px 0; overflow: hidden; display: flex; justify-content: center;\">\n",
        "                    <svg width=\"510\" height=\"230\" viewBox=\"0 0 510 230\" style=\"background:#070b14;\">\n",
        "                        {svg_lines}\n",
        "                        {svg_dots}\n",
        "                    </svg>\n",
        "                </div>\n",
        "\n",
        "                <div style=\"background: #020617; padding: 15px; border-radius: 6px; border: 1px dashed #334155; margin-top: 15px; font-family: 'Courier New', monospace; font-size: 13px; color: #cbd5e1; line-height: 1.6;\">\n",
        "                    <span style=\"color: #38bdf8;\">[✓] CORE SYSTEM INFERENCE LOGS</span><br>\n",
        "                    >> Practice Iteration Loops: {epochs}<br>\n",
        "                    >> Current Residual Error: <span style=\"color: #34d399; font-weight: bold;\">{final_loss:.6f}</span><br>\n",
        "                    >> Computed Target Matrix Guess: <span style=\"color: #fbbf24; font-weight: bold;\">{prediction_value:.4f}</span>\n",
        "                </div>\n",
        "            </div>\n",
        "            <style>\n",
        "                @keyframes terminal_pulse {{ from {{ opacity: 0.5; }} to {{ opacity: 1; }} }}\n",
        "            </style>\n",
        "        '''))\n",
        "\n",
        "# 3. INTERACTIVE LAYOUT ASSIGNMENT\n",
        "run_btn = widgets.Button(description=\"🧠 COMPUTE NETWORK MATRIX\", layout=widgets.Layout(margin='20px 0 0 0', width='280px'))\n",
        "run_btn.style.button_color = '#38bdf8'\n",
        "run_btn.on_click(execute_core_network)\n",
        "\n",
        "ui_box = widgets.VBox([Data_Mode, Hidden_Neurons, Learning_Rate, Epoch_Runs, run_btn])\n",
        "display(ui_box, output_area)\n"
      ],
