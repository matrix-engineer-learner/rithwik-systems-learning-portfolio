        "# @title ⛈️ Project 7: Live Telangana Climate Neural Network & Animated Dashboard\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Dense, Input\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display, HTML, clear_output\n",
        "import time\n",
        "\n",
        "print(\"📡 CONNECTING REGIONAL INFRASTRUCTURE TO PORTAL SERVERS...\")\n",
        "time.sleep(0.5)\n",
        "\n",
        "# 1. LIVE WEB SCRAPE THE MET CENTRE HYDERABAD\n",
        "imd_url = \"https://imd.gov.in\"\n",
        "try:\n",
        "    headers = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64)\"}\n",
        "    page = requests.get(imd_url, headers=headers, timeout=10)\n",
        "    soup = BeautifulSoup(page.content, 'html.parser')\n",
        "    city_items = soup.find_all(['h3', 'div', 'p'])\n",
        "    extracted_temps = []\n",
        "\n",
        "    for item in city_items:\n",
        "        text = item.get_text()\n",
        "        if any(city in text for city in [\"Hyderabad\", \"Nizamabad\", \"Medak\", \"Ramagundam\"]):\n",
        "            for word in text.split():\n",
        "                clean_word = word.replace('°','').replace('°C','').strip()\n",
        "                if clean_word.isdigit():\n",
        "                    val = int(clean_word)\n",
        "                    if 15 <= val <= 48:\n",
        "                        extracted_temps.append(val)\n",
        "                        break\n",
        "\n",
        "    if len(extracted_temps) >= 1:\n",
        "        base_temp = extracted_temps[0]\n",
        "        print(f\"✅ METRIC INGESTION COMPLETE. Baseline Temperature: {base_temp}°C\")\n",
        "    else:\n",
        "        base_temp = 25\n",
        "except Exception as e:\n",
        "    base_temp = 25\n",
        "\n",
        "# Generate regional baseline arrays\n",
        "np.random.seed(42)\n",
        "X_imd = np.random.uniform(-4, 4, (400, 3))\n",
        "X_imd[:, 0] = X_imd[:, 0] + base_temp\n",
        "y_imd = np.where((X_imd[:, 0] > 27) & (X_imd[:, 1] > 0.5), 1, 0)\n",
        "\n",
        "# Build deep layers\n",
        "imd_brain = Sequential([\n",
        "    Input(shape=(3,)),\n",
        "    Dense(12, activation='relu'),\n",
        "    Dense(6, activation='relu'),\n",
        "    Dense(1, activation='sigmoid')\n",
        "])\n",
        "imd_brain.compile(optimizer='adam', loss='binary_crossentropy')\n",
